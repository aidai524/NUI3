{
  "$description": "NUI3 design tokens (DTCG format). Layer 1 = primitives (raw values, never used by components). Layer 2 = semantic tokens per theme (what components read). Source of truth for CSS variables, JS exports and the Tailwind preset.",
  "primitive": {
    "color": {
      "plum":        { "$type": "color", "$value": "#271219", "$description": "z.cash secondary. Primary ink / dark section." },
      "plum-950":    { "$type": "color", "$value": "#140a0d", "$description": "Night theme page background." },
      "plum-900":    { "$type": "color", "$value": "#1d0e13", "$description": "Night theme surface." },
      "plum-800":    { "$type": "color", "$value": "#2b1820", "$description": "Night theme raised surface." },
      "plum-700":    { "$type": "color", "$value": "#3d2730", "$description": "Night theme border." },
      "plum-600":    { "$type": "color", "$value": "#5a4049", "$description": "Night theme strong border." },
      "navy":        { "$type": "color", "$value": "#141529", "$description": "z.cash text color. Alternate dark section." },
      "gold":        { "$type": "color", "$value": "#f3b724", "$description": "z.cash accent. The only brand accent." },
      "gold-600":    { "$type": "color", "$value": "#e0a800", "$description": "Gold hover." },
      "gold-800":    { "$type": "color", "$value": "#8a6100", "$description": "Gold usable as text on light backgrounds (4.9:1 on paper)." },
      "paper":       { "$type": "color", "$value": "#f3f1ef", "$description": "z.cash warm paper background." },
      "paper-alt":   { "$type": "color", "$value": "#f7f7f7" },
      "white":       { "$type": "color", "$value": "#ffffff" },
      "black":       { "$type": "color", "$value": "#000000" },
      "line":        { "$type": "color", "$value": "#e3ded7", "$description": "z.cash warm hairline." },
      "line-strong": { "$type": "color", "$value": "#d5cec6" },
      "line-soft":   { "$type": "color", "$value": "#efece8" },
      "ink-700":     { "$type": "color", "$value": "#4b4146", "$description": "Lead paragraph text." },
      "ink-600":     { "$type": "color", "$value": "#5c5357", "$description": "Secondary text (6.6:1 on paper)." },
      "ink-500":     { "$type": "color", "$value": "#6b6667", "$description": "Muted text, AA-safe replacement for z.cash #797576 (5.0:1 on paper)." },
      "ink-300":     { "$type": "color", "$value": "#b5adaf", "$description": "Decorative only (indices, separators). Never body text." },
      "night-text":  { "$type": "color", "$value": "#f3f1ef" },
      "night-text-2":{ "$type": "color", "$value": "#c9bfc3" },
      "night-text-3":{ "$type": "color", "$value": "#9d8f95" },
      "green-700":   { "$type": "color", "$value": "#1f7a3a" },
      "green-300":   { "$type": "color", "$value": "#5fd08f" },
      "red-700":     { "$type": "color", "$value": "#b42318" },
      "red-300":     { "$type": "color", "$value": "#ff8a7a" },
      "blue-700":    { "$type": "color", "$value": "#2f4a8a" },
      "blue-300":    { "$type": "color", "$value": "#9fb4ff" }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": "\"DM Serif Display\", \"Iowan Old Style\", Georgia, serif", "$description": "Headlines only. Never body or buttons." },
      "sans":    { "$type": "fontFamily", "$value": "Inter, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif" },
      "mono":    { "$type": "fontFamily", "$value": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, monospace", "$description": "Addresses, hashes, indices." }
    }
  },
  "base": {
    "font-size": {
      "display-xl": { "$type": "dimension", "$value": "clamp(56px, 11vw, 160px)" },
      "display-l":  { "$type": "dimension", "$value": "clamp(44px, 6.3vw, 90px)" },
      "display-m":  { "$type": "dimension", "$value": "clamp(36px, 4.9vw, 71px)" },
      "display-s":  { "$type": "dimension", "$value": "clamp(28px, 3.4vw, 42px)" },
      "h2":         { "$type": "dimension", "$value": "clamp(26px, 2.6vw, 37px)" },
      "h3":         { "$type": "dimension", "$value": "24px" },
      "h4":         { "$type": "dimension", "$value": "18px" },
      "lead":       { "$type": "dimension", "$value": "18px" },
      "body":       { "$type": "dimension", "$value": "16px" },
      "small":      { "$type": "dimension", "$value": "14px" },
      "label":      { "$type": "dimension", "$value": "12px", "$description": "Uppercase labels, chips, nav. Minimum for uppercase UI text." },
      "micro":      { "$type": "dimension", "$value": "11px", "$description": "Tags, table headers. Use with text-secondary or stronger." },
      "stat":       { "$type": "dimension", "$value": "40px" }
    },
    "line-height": {
      "display": { "$type": "number", "$value": "1.1" },
      "heading": { "$type": "number", "$value": "1.3" },
      "body":    { "$type": "number", "$value": "1.875", "$description": "Signature airy z.cash body leading." },
      "ui":      { "$type": "number", "$value": "1.5" },
      "tight":   { "$type": "number", "$value": "1" }
    },
    "letter-spacing": {
      "display": { "$type": "dimension", "$value": "-0.01em" },
      "title":   { "$type": "dimension", "$value": "-0.35px" },
      "caps":    { "$type": "dimension", "$value": "0.16em", "$description": "Uppercase labels and nav." },
      "button":  { "$type": "dimension", "$value": "0.2em", "$description": "Uppercase buttons." }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "20": { "$type": "dimension", "$value": "80px" },
      "24": { "$type": "dimension", "$value": "100px" },
      "32": { "$type": "dimension", "$value": "130px" }
    },
    "radius": {
      "base":    { "$type": "dimension", "$value": "0px", "$description": "Cards, panels, dialogs. 0 = z.cash language. Override per product if needed." },
      "control": { "$type": "dimension", "$value": "0px", "$description": "Buttons, inputs, chips." },
      "pill":    { "$type": "dimension", "$value": "999px", "$description": "Only logos, token icons, status dots." }
    },
    "layout": {
      "container":  { "$type": "dimension", "$value": "1360px" },
      "gutter":     { "$type": "dimension", "$value": "clamp(20px, 3.5vw, 50px)" },
      "header-h":   { "$type": "dimension", "$value": "88px" },
      "section-y":  { "$type": "dimension", "$value": "clamp(64px, 9vw, 130px)" },
      "grid-gap":   { "$type": "dimension", "$value": "20px" }
    },
    "density": {
      "control-h":  { "$type": "dimension", "$value": "48px" },
      "control-px": { "$type": "dimension", "$value": "24px" },
      "card-pad":   { "$type": "dimension", "$value": "24px" },
      "cell-py":    { "$type": "dimension", "$value": "14px" },
      "cell-px":    { "$type": "dimension", "$value": "16px" }
    },
    "motion": {
      "dur-fast": { "$type": "duration", "$value": "0.2s" },
      "dur":      { "$type": "duration", "$value": "0.3s" },
      "dur-slow": { "$type": "duration", "$value": "0.5s" },
      "ease":     { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 0.2, 1)" }
    },
    "z": {
      "sticky": { "$type": "number", "$value": "20" },
      "overlay": { "$type": "number", "$value": "100" },
      "toast": { "$type": "number", "$value": "110" }
    }
  },
  "density": {
    "compact": {
      "control-h":  { "$type": "dimension", "$value": "36px" },
      "control-px": { "$type": "dimension", "$value": "16px" },
      "card-pad":   { "$type": "dimension", "$value": "16px" },
      "cell-py":    { "$type": "dimension", "$value": "8px" },
      "cell-px":    { "$type": "dimension", "$value": "12px" }
    }
  },
  "theme": {
    "paper": {
      "$description": "Default. z.cash editorial: warm paper, plum ink, single gold accent.",
      "color-scheme":          { "$type": "string", "$value": "light" },
      "bg":                    { "$type": "color", "$value": "{primitive.color.paper}" },
      "bg-alt":                { "$type": "color", "$value": "{primitive.color.paper-alt}" },
      "surface":               { "$type": "color", "$value": "{primitive.color.white}" },
      "surface-raised":        { "$type": "color", "$value": "{primitive.color.white}" },
      "surface-sunken":        { "$type": "color", "$value": "{primitive.color.paper}" },
      "text":                  { "$type": "color", "$value": "{primitive.color.plum}" },
      "text-secondary":        { "$type": "color", "$value": "{primitive.color.ink-600}" },
      "text-muted":            { "$type": "color", "$value": "{primitive.color.ink-500}" },
      "text-decorative":       { "$type": "color", "$value": "{primitive.color.ink-300}" },
      "border":                { "$type": "color", "$value": "{primitive.color.line}" },
      "border-strong":         { "$type": "color", "$value": "{primitive.color.line-strong}" },
      "border-soft":           { "$type": "color", "$value": "{primitive.color.line-soft}" },
      "border-focus":          { "$type": "color", "$value": "{primitive.color.plum}" },
      "accent":                { "$type": "color", "$value": "{primitive.color.gold}", "$description": "Fills, underlines, rules, dots. <=10% of screen." },
      "accent-hover":          { "$type": "color", "$value": "{primitive.color.gold-600}" },
      "on-accent":             { "$type": "color", "$value": "{primitive.color.plum}" },
      "accent-text":           { "$type": "color", "$value": "{primitive.color.gold-800}", "$description": "Accent used as text color; contrast-safe." },
      "positive":              { "$type": "color", "$value": "{primitive.color.green-700}" },
      "negative":              { "$type": "color", "$value": "{primitive.color.red-700}" },
      "warning":               { "$type": "color", "$value": "{primitive.color.gold-800}" },
      "info":                  { "$type": "color", "$value": "{primitive.color.blue-700}" },
      "privacy-shielded":      { "$type": "color", "$value": "{primitive.color.gold-800}" },
      "privacy-confidential":  { "$type": "color", "$value": "{primitive.color.blue-700}" },
      "privacy-public":        { "$type": "color", "$value": "{primitive.color.ink-500}" },
      "inverse-bg":            { "$type": "color", "$value": "{primitive.color.plum}", "$description": "Dark sections inside a light page." },
      "inverse-text":          { "$type": "color", "$value": "{primitive.color.white}" },
      "inverse-text-secondary":{ "$type": "color", "$value": "{primitive.color.night-text-2}" },
      "inverse-accent-text":   { "$type": "color", "$value": "{primitive.color.gold}" },
      "footer-bg":             { "$type": "color", "$value": "{primitive.color.black}" },
      "scrim":                 { "$type": "color", "$value": "rgba(39, 18, 25, 0.55)" },
      "focus-ring":            { "$type": "color", "$value": "{primitive.color.gold}" },
      "chart-1":               { "$type": "color", "$value": "{primitive.color.gold-800}", "$description": "Primary series. Charts use chart-1..5 in order." },
      "chart-2":               { "$type": "color", "$value": "{primitive.color.blue-700}" },
      "chart-3":               { "$type": "color", "$value": "{primitive.color.green-700}" },
      "chart-4":               { "$type": "color", "$value": "{primitive.color.plum}" },
      "chart-5":               { "$type": "color", "$value": "{primitive.color.ink-500}" },
      "chart-grid":            { "$type": "color", "$value": "{primitive.color.line-soft}" }
    },
    "night": {
      "$description": "Dark app theme for trading / wallet surfaces (Noir). Same accent and shape language.",
      "color-scheme":          { "$type": "string", "$value": "dark" },
      "bg":                    { "$type": "color", "$value": "{primitive.color.plum-950}" },
      "bg-alt":                { "$type": "color", "$value": "{primitive.color.plum-900}" },
      "surface":               { "$type": "color", "$value": "{primitive.color.plum-900}" },
      "surface-raised":        { "$type": "color", "$value": "{primitive.color.plum-800}" },
      "surface-sunken":        { "$type": "color", "$value": "{primitive.color.plum-950}" },
      "text":                  { "$type": "color", "$value": "{primitive.color.night-text}" },
      "text-secondary":        { "$type": "color", "$value": "{primitive.color.night-text-2}" },
      "text-muted":            { "$type": "color", "$value": "{primitive.color.night-text-3}" },
      "text-decorative":       { "$type": "color", "$value": "{primitive.color.plum-600}" },
      "border":                { "$type": "color", "$value": "{primitive.color.plum-700}" },
      "border-strong":         { "$type": "color", "$value": "{primitive.color.plum-600}" },
      "border-soft":           { "$type": "color", "$value": "{primitive.color.plum-800}" },
      "border-focus":          { "$type": "color", "$value": "{primitive.color.gold}" },
      "accent":                { "$type": "color", "$value": "{primitive.color.gold}" },
      "accent-hover":          { "$type": "color", "$value": "{primitive.color.gold-600}" },
      "on-accent":             { "$type": "color", "$value": "{primitive.color.plum}" },
      "accent-text":           { "$type": "color", "$value": "{primitive.color.gold}" },
      "positive":              { "$type": "color", "$value": "{primitive.color.green-300}" },
      "negative":              { "$type": "color", "$value": "{primitive.color.red-300}" },
      "warning":               { "$type": "color", "$value": "{primitive.color.gold}" },
      "info":                  { "$type": "color", "$value": "{primitive.color.blue-300}" },
      "privacy-shielded":      { "$type": "color", "$value": "{primitive.color.gold}" },
      "privacy-confidential":  { "$type": "color", "$value": "{primitive.color.blue-300}" },
      "privacy-public":        { "$type": "color", "$value": "{primitive.color.night-text-3}" },
      "inverse-bg":            { "$type": "color", "$value": "{primitive.color.paper}" },
      "inverse-text":          { "$type": "color", "$value": "{primitive.color.plum}" },
      "inverse-text-secondary":{ "$type": "color", "$value": "{primitive.color.ink-600}" },
      "inverse-accent-text":   { "$type": "color", "$value": "{primitive.color.gold-800}" },
      "footer-bg":             { "$type": "color", "$value": "{primitive.color.black}" },
      "scrim":                 { "$type": "color", "$value": "rgba(0, 0, 0, 0.66)" },
      "focus-ring":            { "$type": "color", "$value": "{primitive.color.gold}" },
      "chart-1":               { "$type": "color", "$value": "{primitive.color.gold}" },
      "chart-2":               { "$type": "color", "$value": "{primitive.color.blue-300}" },
      "chart-3":               { "$type": "color", "$value": "{primitive.color.green-300}" },
      "chart-4":               { "$type": "color", "$value": "{primitive.color.night-text-2}" },
      "chart-5":               { "$type": "color", "$value": "{primitive.color.night-text-3}" },
      "chart-grid":            { "$type": "color", "$value": "{primitive.color.plum-800}" }
    }
  },
  "contrast": {
    "$description": "Pairs checked by `pnpm test` in @nui3/tokens. [foreground, background, minimum ratio].",
    "pairs": [
      ["text", "bg", 7], ["text", "surface", 7],
      ["text-secondary", "bg", 4.5], ["text-secondary", "surface", 4.5],
      ["text-muted", "bg", 4.5], ["text-muted", "surface", 4.5],
      ["accent-text", "bg", 4.5], ["accent-text", "surface", 4.5],
      ["on-accent", "accent", 4.5],
      ["positive", "surface", 4.5], ["negative", "surface", 4.5], ["info", "surface", 4.5],
      ["privacy-shielded", "surface", 4.5], ["privacy-confidential", "surface", 4.5], ["privacy-public", "surface", 4.5],
      ["inverse-text", "inverse-bg", 7], ["inverse-text-secondary", "inverse-bg", 4.5], ["inverse-accent-text", "inverse-bg", 4.5],
      ["chart-1", "surface", 3], ["chart-2", "surface", 3], ["chart-3", "surface", 3], ["chart-4", "surface", 3], ["chart-5", "surface", 3]
    ]
  }
}
