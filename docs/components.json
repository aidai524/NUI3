{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "name": "NUI3",
 "version": "0.1.0",
 "packages": {
  "@nui3/react": "React components + utils",
  "@nui3/css": "CSS (nui-* classes) for any framework",
  "@nui3/tokens": "Design tokens, themes, Tailwind preset"
 },
 "rules": "See AGENTS.md — hard rules override any example.",
 "themes": [
  "paper",
  "night",
  "auto"
 ],
 "density": [
  "comfortable",
  "compact"
 ],
 "components": [
  {
   "name": "ThemeProvider",
   "group": "theme",
   "description": "Scope a theme, density and token overrides to a subtree.",
   "props": {
    "theme": "'paper'|'night'|'auto'|string",
    "density": "'comfortable'|'compact'",
    "tokens": "TokenOverrides",
    "root": "boolean = true"
   },
   "example": "<ThemeProvider theme=\"night\" tokens={{ accent: '#7ee0c3' }}>{app}</ThemeProvider>"
  },
  {
   "name": "Display",
   "group": "foundation",
   "description": "Serif headline. Page/section titles only.",
   "props": {
    "as": "tag = h1",
    "size": "'xl'|'l'|'m'|'s'"
   },
   "example": "<Display size=\"l\">Stay shielded.</Display>",
   "cssClass": "nui-display"
  },
  {
   "name": "Heading",
   "group": "foundation",
   "description": "Inter bold heading.",
   "props": {
    "level": "2|3|4"
   },
   "example": "<Heading level={3}>Pools</Heading>",
   "cssClass": "nui-heading"
  },
  {
   "name": "Eyebrow",
   "group": "foundation",
   "description": "Uppercase label above a headline.",
   "props": {
    "accent": "boolean"
   },
   "example": "<Eyebrow>Bridge</Eyebrow>",
   "cssClass": "nui-eyebrow"
  },
  {
   "name": "Lead",
   "group": "foundation",
   "description": "Intro paragraph, max 52ch.",
   "props": {},
   "example": "<Lead>Move ZEC across chains.</Lead>",
   "cssClass": "nui-lead"
  },
  {
   "name": "Shell",
   "group": "foundation",
   "description": "Centered max-width container.",
   "props": {
    "as": "tag"
   },
   "example": "<Shell>…</Shell>",
   "cssClass": "nui-shell"
  },
  {
   "name": "Section",
   "group": "foundation",
   "description": "Vertical page section. One dark tone per section.",
   "props": {
    "tone": "'default'|'inverse'|'plum'|'navy'",
    "contained": "boolean = true"
   },
   "example": "<Section tone=\"plum\">…</Section>",
   "cssClass": "nui-section"
  },
  {
   "name": "Stack",
   "group": "foundation",
   "description": "Vertical flex with gap.",
   "props": {
    "gap": "space step"
   },
   "example": "<Stack gap={6}>…</Stack>",
   "cssClass": "nui-stack"
  },
  {
   "name": "Cluster",
   "group": "foundation",
   "description": "Horizontal wrapping row.",
   "props": {
    "gap": "space step",
    "justify": "CSS justify-content"
   },
   "example": "<Cluster justify=\"space-between\">…</Cluster>",
   "cssClass": "nui-cluster"
  },
  {
   "name": "Grid",
   "group": "foundation",
   "description": "Responsive grid: 3→2→1 columns.",
   "props": {
    "cols": "1|2|3|4|'auto'",
    "min": "string (auto)"
   },
   "example": "<Grid cols={3}>{cards}</Grid>",
   "cssClass": "nui-grid"
  },
  {
   "name": "Button",
   "group": "actions",
   "description": "Button or link. ghost default; solid = the one primary action per view.",
   "props": {
    "variant": "'ghost'|'solid'|'outline'|'subtle'|'underline'|'danger'|'invert'",
    "size": "'sm'|'md'|'lg'",
    "block": "boolean",
    "arrow": "boolean",
    "loading": "boolean",
    "href": "string → renders <a>"
   },
   "example": "<Button variant=\"solid\" block>Review swap</Button>",
   "cssClass": "nui-btn"
  },
  {
   "name": "IconButton",
   "group": "actions",
   "description": "Icon-only button. label is required.",
   "props": {
    "label": "string",
    "size": "'sm'|'md'"
   },
   "example": "<IconButton label=\"Close\"><CloseIcon/></IconButton>",
   "cssClass": "nui-icon-btn"
  },
  {
   "name": "ChipGroup",
   "group": "actions",
   "description": "Single-select filter row with arrow-key navigation.",
   "props": {
    "options": "Option[]",
    "value": "string",
    "onChange": "(v) => void",
    "aria-label": "string"
   },
   "example": "<ChipGroup aria-label=\"Category\" options={cats} value={cat} onChange={setCat}/>",
   "cssClass": "nui-chips"
  },
  {
   "name": "Tabs",
   "group": "actions",
   "description": "Tablist; pair with TabPanel.",
   "props": {
    "items": "Option[]",
    "value": "string",
    "onChange": "fn",
    "id": "string"
   },
   "example": "<Tabs id=\"t\" aria-label=\"View\" items={items} value={v} onChange={setV}/>",
   "cssClass": "nui-tabs"
  },
  {
   "name": "Segmented",
   "group": "actions",
   "description": "Compact radio group (Long/Short, Market/Limit, 1D/1W).",
   "props": {
    "options": "Option[]",
    "value": "string",
    "onChange": "fn"
   },
   "example": "<Segmented aria-label=\"Side\" options={[{value:'long',label:'Long'},{value:'short',label:'Short'}]} value={side} onChange={setSide}/>",
   "cssClass": "nui-segmented"
  },
  {
   "name": "Field",
   "group": "forms",
   "description": "Label + hint + error wrapper; auto-wires ids/aria to its control.",
   "props": {
    "label": "ReactNode",
    "labelAside": "ReactNode",
    "hint": "ReactNode",
    "error": "ReactNode",
    "hideLabel": "boolean"
   },
   "example": "<Field label=\"Recipient\" error={err}><Input mono/></Field>",
   "cssClass": "nui-field"
  },
  {
   "name": "Input",
   "group": "forms",
   "description": "Text input.",
   "props": {
    "mono": "boolean"
   },
   "example": "<Input placeholder=\"u1…\" mono/>",
   "cssClass": "nui-input"
  },
  {
   "name": "Textarea",
   "group": "forms",
   "description": "Multiline input.",
   "props": {},
   "example": "<Textarea rows={4}/>",
   "cssClass": "nui-textarea"
  },
  {
   "name": "Select",
   "group": "forms",
   "description": "Native select.",
   "props": {},
   "example": "<Select><option>Zcash</option></Select>",
   "cssClass": "nui-select"
  },
  {
   "name": "InputGroup",
   "group": "forms",
   "description": "Input with start/end addons.",
   "props": {
    "start": "ReactNode",
    "end": "ReactNode"
   },
   "example": "<InputGroup end=\"%\" value={slippage}/>",
   "cssClass": "nui-input-group"
  },
  {
   "name": "SearchInput",
   "group": "forms",
   "description": "Underline search with '/' shortcut and Escape to clear.",
   "props": {
    "label": "string",
    "shortcut": "boolean",
    "onClear": "fn"
   },
   "example": "<SearchInput label=\"Search\" value={q} onChange={e=>setQ(e.target.value)}/>",
   "cssClass": "nui-search"
  },
  {
   "name": "Switch",
   "group": "forms",
   "description": "Toggle switch.",
   "props": {
    "checked": "boolean",
    "onChange": "fn",
    "label": "ReactNode"
   },
   "example": "<Switch label=\"Hide balances\" checked={h} onChange={setH}/>",
   "cssClass": "nui-switch"
  },
  {
   "name": "Checkbox",
   "group": "forms",
   "description": "Checkbox with label.",
   "props": {
    "label": "ReactNode"
   },
   "example": "<Checkbox label=\"I understand the risks\"/>",
   "cssClass": "nui-check"
  },
  {
   "name": "ZcashMark",
   "group": "navigation",
   "description": "Official Zcash mark. Do not recolor; link to https://z.cash/.",
   "props": {
    "size": "number",
    "variant": "'color'|'mono'",
    "title": "string"
   },
   "example": "<ZcashMark size={24}/>"
  },
  {
   "name": "Brand",
   "group": "navigation",
   "description": "Product logo lockup. Name must not contain 'Zcash'.",
   "props": {
    "name": "ReactNode",
    "logo": "ReactNode",
    "sub": "ReactNode",
    "href": "string"
   },
   "example": "<Brand name=\"Noir\" sub=\"Bridge\"/>",
   "cssClass": "nui-brand"
  },
  {
   "name": "Header",
   "group": "navigation",
   "description": "Top bar with brand, dropdown nav groups, actions and a mobile drawer.",
   "props": {
    "brand": "ReactNode",
    "nav": "NavItem[] (children => dropdown group)",
    "actions": "ReactNode",
    "sticky": "boolean",
    "bordered": "boolean",
    "renderLink": "router adapter",
    "mobileActions": "ReactNode",
    "menuLabel": "string"
   },
   "example": "<Header brand={<Brand name=\"Noir\"/>} nav={nav} actions={<Button variant=\"outline\" size=\"sm\">Connect</Button>}/>",
   "cssClass": "nui-header"
  },
  {
   "name": "Breadcrumb",
   "group": "navigation",
   "description": "Breadcrumb trail.",
   "props": {
    "items": "{label, href?}[]"
   },
   "example": "<Breadcrumb items={[{label:'Explorer',href:'/'},{label:'Tx'}]}/>",
   "cssClass": "nui-breadcrumb"
  },
  {
   "name": "Footer",
   "group": "navigation",
   "description": "Footer with columns; always renders the trademark disclaimer.",
   "props": {
    "columns": "FooterColumn[]",
    "tagline": "ReactNode",
    "legal": "ReactNode",
    "disclaimer": "ReactNode (reword, not remove)"
   },
   "example": "<Footer columns={cols} legal=\"© 2026 Noir\"/>",
   "cssClass": "nui-footer"
  },
  {
   "name": "Card",
   "group": "surfaces",
   "description": "Bordered surface. interactive = gold hover rule.",
   "props": {
    "interactive": "boolean",
    "as": "tag"
   },
   "example": "<Card interactive>…</Card>",
   "cssClass": "nui-card"
  },
  {
   "name": "ProjectCard",
   "group": "surfaces",
   "description": "Directory card (z.cash ecosystem style), whole card clickable.",
   "props": {
    "name": "string",
    "description": "ReactNode",
    "href": "string",
    "tags": "string[]",
    "logo": "ReactNode",
    "index": "number"
   },
   "example": "<ProjectCard name=\"Zodl\" href=\"https://zodl.com\" tags={['wallets']}/>",
   "cssClass": "nui-card"
  },
  {
   "name": "Panel",
   "group": "surfaces",
   "description": "App widget container with header/footer.",
   "props": {
    "title": "ReactNode",
    "actions": "ReactNode",
    "footer": "ReactNode",
    "sunken": "boolean",
    "flush": "boolean"
   },
   "example": "<Panel title=\"Swap\" actions={<PrivacyBadge level=\"confidential\"/>}>…</Panel>",
   "cssClass": "nui-panel"
  },
  {
   "name": "Stats",
   "group": "surfaces",
   "description": "KPI bar (<dl>). divided = z.cash data bar.",
   "props": {
    "divided": "boolean"
   },
   "example": "<Stats divided><Stat label=\"TVL\" value=\"48.2\" unit=\"M\"/></Stats>",
   "cssClass": "nui-stats"
  },
  {
   "name": "Stat",
   "group": "surfaces",
   "description": "Single KPI: label, big tabular number, optional delta.",
   "props": {
    "label": "ReactNode",
    "value": "ReactNode",
    "unit": "ReactNode",
    "delta": "ReactNode",
    "size": "'md'|'sm'"
   },
   "example": "<Stat label=\"ZEC price\" value=\"$951.63\" delta={<PriceChange value={2.4}/>}/>",
   "cssClass": "nui-stat"
  },
  {
   "name": "Badge",
   "group": "surfaces",
   "description": "Small status label.",
   "props": {
    "tone": "'neutral'|'positive'|'negative'|'warning'|'info'|'accent'",
    "dot": "boolean",
    "solid": "boolean"
   },
   "example": "<Badge tone=\"positive\" dot>Active</Badge>",
   "cssClass": "nui-badge"
  },
  {
   "name": "Alert",
   "group": "surfaces",
   "description": "Inline notice; required for risk disclosures.",
   "props": {
    "tone": "'info'|'positive'|'negative'|'warning'|'shielded'",
    "title": "ReactNode",
    "action": "ReactNode"
   },
   "example": "<Alert tone=\"warning\" title=\"Liquidation risk\">…</Alert>",
   "cssClass": "nui-alert"
  },
  {
   "name": "DataTable",
   "group": "surfaces",
   "description": "Sortable table with sticky header and loading skeleton.",
   "props": {
    "columns": "Column[] {key, header, cell, numeric?, sortValue?}",
    "rows": "Row[]",
    "rowKey": "fn",
    "loading": "boolean",
    "empty": "ReactNode",
    "onRowClick": "fn",
    "defaultSort": "{key, direction}"
   },
   "example": "<DataTable columns={cols} rows={txs} rowKey={r=>r.hash}/>",
   "cssClass": "nui-table"
  },
  {
   "name": "KeyValue",
   "group": "surfaces",
   "description": "Label/value detail list.",
   "props": {
    "items": "{label, value}[]",
    "alignLeft": "boolean"
   },
   "example": "<KeyValue items={[{label:'Fee',value:'0.0001 ZEC'}]}/>",
   "cssClass": "nui-kv"
  },
  {
   "name": "Stepper",
   "group": "surfaces",
   "description": "Multi-step progress.",
   "props": {
    "steps": "{title, description?, state: 'pending'|'active'|'complete'|'error'}[]",
    "orientation": "'vertical'|'horizontal'"
   },
   "example": "<Stepper steps={steps}/>",
   "cssClass": "nui-stepper"
  },
  {
   "name": "Progress",
   "group": "surfaces",
   "description": "Progress bar; omit value for indeterminate.",
   "props": {
    "value": "0-100",
    "label": "string"
   },
   "example": "<Progress label=\"Uploading\" value={40}/>",
   "cssClass": "nui-progress"
  },
  {
   "name": "Skeleton",
   "group": "surfaces",
   "description": "Loading placeholder.",
   "props": {
    "width": "CSS",
    "height": "CSS"
   },
   "example": "<Skeleton width={120}/>",
   "cssClass": "nui-skeleton"
  },
  {
   "name": "EmptyState",
   "group": "surfaces",
   "description": "No-results block.",
   "props": {
    "title": "ReactNode",
    "hint": "ReactNode",
    "action": "ReactNode"
   },
   "example": "<EmptyState title=\"Nothing matches.\" action={<Button>Clear filters</Button>}/>",
   "cssClass": "nui-empty"
  },
  {
   "name": "Dialog",
   "group": "overlays",
   "description": "Modal on native <dialog>.",
   "props": {
    "open": "boolean",
    "onClose": "fn",
    "title": "ReactNode",
    "footer": "ReactNode",
    "width": "number",
    "dismissible": "boolean = true"
   },
   "example": "<Dialog open={o} onClose={close} title=\"Confirm swap\" footer={<Button variant=\"solid\">Confirm</Button>}>…</Dialog>",
   "cssClass": "nui-dialog"
  },
  {
   "name": "ToastProvider / useToast",
   "group": "overlays",
   "description": "Notifications. Wrap app once; call toast().",
   "props": {
    "toast": "({title, description?, tone?, duration?, action?}) => id",
    "dismiss": "(id) => void"
   },
   "example": "const { toast } = useToast(); toast({ title: 'Swap submitted', tone: 'positive' })",
   "cssClass": "nui-toast"
  },
  {
   "name": "Address",
   "group": "zcash",
   "description": "Zcash address with type tag (Unified/Sapling/Transparent/TEX), truncation and copy.",
   "props": {
    "address": "string",
    "truncate": "[head, tail] | false",
    "copyable": "boolean",
    "showKind": "boolean",
    "href": "string"
   },
   "example": "<Address address={ua}/>",
   "cssClass": "nui-address"
  },
  {
   "name": "Hash",
   "group": "zcash",
   "description": "Tx id / block hash with copy and explorer link.",
   "props": {
    "value": "string",
    "href": "string",
    "truncate": "[head, tail] | false"
   },
   "example": "<Hash value={txid} href={`/tx/${txid}`}/>",
   "cssClass": "nui-hash"
  },
  {
   "name": "CopyButton / useCopy",
   "group": "zcash",
   "description": "Clipboard button and hook.",
   "props": {
    "value": "string",
    "label": "string"
   },
   "example": "<CopyButton value={uri}/>",
   "cssClass": "nui-copy"
  },
  {
   "name": "Amount",
   "group": "zcash",
   "description": "Token amount from bigint base units. Never shows dust as 0.",
   "props": {
    "value": "bigint|string|number (base units)",
    "decimals": "number = 8",
    "symbol": "string|null = 'ZEC'",
    "exact": "boolean",
    "fiat": "number",
    "hidden": "boolean",
    "sign": "'auto'|'none'",
    "size": "'md'|'lg'"
   },
   "example": "<Amount value={123450000n} fiat={117.4}/>",
   "cssClass": "nui-amount"
  },
  {
   "name": "PriceChange",
   "group": "zcash",
   "description": "Percent change with ▲/▼ color.",
   "props": {
    "value": "number (percent)"
   },
   "example": "<PriceChange value={-1.2}/>",
   "cssClass": "nui-delta"
  },
  {
   "name": "PrivacyBadge",
   "group": "zcash",
   "description": "Canonical privacy level: shielded / confidential / public. See PRIVACY_LEVELS.",
   "props": {
    "level": "'shielded'|'confidential'|'public'",
    "label": "string",
    "describe": "boolean = true"
   },
   "example": "<PrivacyBadge level=\"shielded\"/>",
   "cssClass": "nui-privacy"
  },
  {
   "name": "PoolBadge",
   "group": "zcash",
   "description": "Zcash value pool indicator.",
   "props": {
    "pool": "'orchard'|'sapling'|'transparent'"
   },
   "example": "<PoolBadge pool=\"orchard\"/>",
   "cssClass": "nui-pool"
  },
  {
   "name": "ChainBadge",
   "group": "zcash",
   "description": "Chain/network label with icon.",
   "props": {
    "name": "string",
    "icon": "ReactNode"
   },
   "example": "<ChainBadge name=\"NEAR\"/>",
   "cssClass": "nui-chain"
  },
  {
   "name": "TokenIcon / TokenPair",
   "group": "zcash",
   "description": "Round token logo with letter fallback; ZEC renders gold.",
   "props": {
    "symbol": "string",
    "src": "string",
    "size": "'sm'|'md'|'lg'"
   },
   "example": "<TokenPair base={{symbol:'ZEC'}} quote={{symbol:'USDC'}}/>",
   "cssClass": "nui-token-icon"
  },
  {
   "name": "TxStatus",
   "group": "zcash",
   "description": "Transaction state with live region.",
   "props": {
    "status": "'pending'|'confirming'|'confirmed'|'failed'|'expired'|'refunded'",
    "confirmations": "number",
    "required": "number"
   },
   "example": "<TxStatus status=\"confirming\" confirmations={3} required={10}/>",
   "cssClass": "nui-tx-status"
  },
  {
   "name": "SyncProgress",
   "group": "zcash",
   "description": "Light-wallet scan progress.",
   "props": {
    "height": "number",
    "tip": "number",
    "from": "number",
    "eta": "string"
   },
   "example": "<SyncProgress height={h} tip={tip} from={birthday}/>",
   "cssClass": "nui-sync"
  },
  {
   "name": "MemoInput",
   "group": "zcash",
   "description": "Encrypted memo with 512-byte counter; disabled for transparent recipients.",
   "props": {
    "value": "string",
    "onChange": "fn",
    "recipient": "string",
    "maxBytes": "number = 512"
   },
   "example": "<Field label=\"Memo\"><MemoInput value={m} onChange={setM} recipient={to}/></Field>",
   "cssClass": "nui-memo"
  },
  {
   "name": "ReceiveQR",
   "group": "zcash",
   "description": "QR for an address or ZIP-321 URI.",
   "props": {
    "value": "string",
    "size": "number",
    "caption": "ReactNode"
   },
   "example": "<ReceiveQR value={buildPaymentUri({ address, amount: '0.5' })}/>",
   "cssClass": "nui-qr"
  },
  {
   "name": "TokenAmountInput",
   "group": "defi",
   "description": "Amount + token selector + balance/MAX. Core of Swap/Bridge/Lend/Perps.",
   "props": {
    "value": "decimal string",
    "onChange": "fn (sanitized)",
    "token": "TokenInfo",
    "onTokenClick": "fn",
    "label": "ReactNode",
    "aside": "ReactNode",
    "fiat": "ReactNode",
    "onMax": "(decimal string) => void",
    "readOnly": "boolean",
    "invalid": "boolean"
   },
   "example": "<TokenAmountInput label=\"You pay\" value={v} onChange={setV} token={zec} onTokenClick={open} onMax={setV}/>",
   "cssClass": "nui-token-input"
  },
  {
   "name": "TokenPicker",
   "group": "defi",
   "description": "Searchable token selection dialog.",
   "props": {
    "open": "boolean",
    "onClose": "fn",
    "tokens": "TokenInfo[]",
    "onSelect": "fn",
    "selected": "TokenInfo",
    "disabled": "TokenInfo[]",
    "popular": "TokenInfo[]"
   },
   "example": "<TokenPicker open={o} onClose={close} tokens={list} onSelect={setToken}/>",
   "cssClass": "nui-token-list"
  },
  {
   "name": "SwapSwitch",
   "group": "defi",
   "description": "Flip button between two token inputs.",
   "props": {
    "onClick": "fn"
   },
   "example": "<SwapSwitch onClick={flip}/>",
   "cssClass": "nui-swap-switch"
  },
  {
   "name": "HealthFactor",
   "group": "defi",
   "description": "Lending health / margin meter with zones.",
   "props": {
    "value": "number (Infinity = no debt)",
    "liquidation": "number = 1",
    "warning": "number = 1.5",
    "max": "number = 3"
   },
   "example": "<HealthFactor value={1.42}/>",
   "cssClass": "nui-health"
  },
  {
   "name": "DetailList",
   "group": "defi",
   "description": "Compact rate/fee/route rows under a form.",
   "props": {
    "items": "{label, value}[]"
   },
   "example": "<DetailList items={[{label:'Fee',value:'0.30%'}]}/>",
   "cssClass": "nui-detail-list"
  },
  {
   "name": "LocaleProvider / useNuiLocale",
   "group": "i18n",
   "description": "Localize every built-in string and number format. `en` and `zh` packs included; override any message.",
   "props": {
    "locale": "string BCP-47 ('en'|'zh'|…)",
    "base": "NuiMessages",
    "messages": "Partial<NuiMessages>",
    "useNuiLocale()": "{ locale, m }"
   },
